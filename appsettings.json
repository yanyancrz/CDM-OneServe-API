    "MaxOutputTokens": 300,
    "TimeoutSeconds": 20,
    "DailyLimitPerUser": 50
  },

  "WebPush": {
    /*
     * Browser push notifications (Web Push Protocol / RFC 8030).
     *
     * VapidPublicKey  - PUBLIC. Safe to ship in the browser bundle; it is
     *                  published in every VAPID token anyway. Exposed to
     *                  the frontend through GET /api/push/vapid-public-key
     *                  and through VITE_VAPID_PUBLIC_KEY at build time.
     * VapidSubject    - "mailto:" address of who ran the key pair. Push
     *                  services require it; it is public too.
     *
     * The PRIVATE key is deliberately NOT here: it lives only in the
     * push-service/.env of the Node notification service, never in this
     * repo and never in the browser.
     *
     * Generate a pair with:  npm run keys --prefix push-service
     */
    "VapidPublicKey": "BL7Ksq5DU1aEIkHb5_bVif-YgoA5YXNxdkvmfUsVfQAgC6-bVbZFnVABs69LIKnfUKNM3Mmd21wt-KAhbwPQVZc",
    "VapidSubject": "mailto:cdmoneserve@gmail.com"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
